# ── Feedback mailbox (IMPORTANT) ────────────────────────────────────────────
# Authorize OAuth as the mailbox that RECEIVES feedback.
# That account's inbox is what this script reads. GCP project can live under a
# another Google account, but the Playground login / refresh token MUST be for
# the feedback inbox itself.

# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: only forward emails From this address.
# Leave EMPTY to forward all new feedback mail in the authorized inbox.
SENDER_EMAIL_FILTER=

# Green API credentials (from https://green-api.com dashboard)
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# Optional: copy exact API URL from Green API dashboard (e.g. https://7107.api.greenapi.com)
# If empty, derived from first 4 digits of GREEN_API_ID_INSTANCE
GREEN_API_URL=

# Optional media host for attachments (default: https://media.green-api.com)
GREEN_API_MEDIA_URL=

# WhatsApp recipient — individual: 923001234567@c.us | group: 120363012345678901@g.us
WHATSAPP_CHAT_ID=
