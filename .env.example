# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Only forward emails from this sender
SENDER_EMAIL_FILTER=

# Green API credentials (from https://green-api.com dashboard)
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# Optional: copy exact API URL from Green API dashboard (e.g. https://7107.api.greenapi.com)
# If empty, derived from first 4 digits of GREEN_API_ID_INSTANCE
GREEN_API_URL=

# WhatsApp recipient — individual: 923001234567@c.us | group: 120363012345678901@g.us
WHATSAPP_CHAT_ID=
